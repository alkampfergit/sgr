<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Alkampfer.Sgr</PackageId>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Authors>Alkampfer</Authors>
    <Description>Schema-guided reasoning primitives and models for .NET applications.</Description>
    <RepositoryUrl>https://github.com/alkampfergit/sgr</RepositoryUrl>
    <PackageProjectUrl>https://github.com/alkampfergit/sgr</PackageProjectUrl>
    <PackageTags>ai;openai;schema;reasoning;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.AI.OpenAI" Version="2.5.0-beta.1" />
    <PackageReference Include="JsonSchema.Net" Version="7.4.0" />
    <PackageReference Include="JsonSchema.Net.Generation" Version="5.1.1" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.2" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.10" />
    <PackageReference Include="NJsonSchema.CodeGeneration" Version="11.5.1" />
    <PackageReference Include="NJsonSchema.NewtonsoftJson" Version="11.5.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="OpenAI" Version="2.5.0" />
    <PackageReference Include="EPPlus" Version="8.2.1" />
    <PackageReference Include="Spectre.Console" Version="0.52.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
